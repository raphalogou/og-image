{
    "name": "void/og-image-bundle",
    "description": "An Open Graph Image generator bundle",
    "type": "symfony-bundle",
    "license": "MIT",
    "minimum-stability": "stable",
    "authors": [
        {
            "name": "Raphael Alogou",
            "email": "raphalogou@gmail.com"
        }
    ],
    "require": {
        "intervention/image": "^3.11",
        "symfony/dependency-injection": "^7.4|^8.0",
        "symfony/filesystem": "^7.4|^8.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.94",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Void\\OgImageBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Void\\OgImageBundle\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-html coverage"
    },
    "config": {
        "sort-packages": true
    },
    "allow-plugins": {
        "symfony/flex": true
    }
}
