{
    "name": "void/og-image",
    "description": "A minimal Open Graph Image generator library",
    "type": "library",
    "license": "MIT",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "authors": [
        {
            "name": "Raphael Alogou",
            "email": "raphalogou@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "intervention/image": "^3.11"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.94",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.0",
        "symfony/framework-bundle": "^7.4|^8.0"
    },
    "autoload": {
        "psr-4": {
            "Void\\OgImage\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Void\\OgImage\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-html coverage"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "symfony/flex": true
        }
    }
}
